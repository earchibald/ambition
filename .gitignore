# Godot-specific ignores
.godot/
*.translation
*.import
export.cfg
export_presets.cfg

# Logs and OS files
*.log
.DS_Store
Thumbs.db

# Secrets — LLM API key must never be committed (ADR-5)
*.secret
llm_secrets.cfg
.env

# Clearance rendered-preview artifacts
.clearance-rendered-preview-*/

# CI / test artifacts
gut_results.xml
boot.log

# Soak-harness output (ADR-20). Baselines under tests/soak/baselines/ ARE committed.
soak_out/

# NOTE on *.import above: those sidecars are normally committed so CI does not re-import art
# from scratch. Harmless while assets/ is empty; revisit before adding real assets.
