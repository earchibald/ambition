; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="The Living Delve"
run/main_scene="res://viewer/Main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

; Order is critical and load-bearing. Events must exist before Manager; Manager before Loop,
; so GameLoopManager._physics_process runs after the state it drives exists (ADR-9).
; All three scripts `extends Node` — Godot refuses to autoload anything that does not.
ECSEvents="*res://singletons/ECSEvents.gd"
RNGService="*res://singletons/RNGService.gd"
GameClock="*res://singletons/GameClock.gd"
ECSManager="*res://singletons/ECSManager.gd"
World="*res://singletons/World.gd"
GameLoopManager="*res://singletons/GameLoopManager.gd"

[display]

; Without a stretch mode, CanvasLayer text is drawn at a fixed pixel size and does NOT scale
; when the window is resized — so enlarging the window made the overlay text relatively smaller,
; which is the opposite of what resizing is for. `canvas_items` scales 2D/UI against the
; reference resolution below; 3D still renders at native resolution.
window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/gut/plugin.cfg")

[input]

; Sprint 1 Step 4 uses Input.get_vector(), which pushes an error every frame on unmapped
; actions. The Sprint 0 gate asserts InputMap.has_action() for each of these (viewer/Main.gd).
; physical_keycode values: W=87 A=65 S=83 D=68 E=69 T=84 G=71 Minus=45 Equal=61 Shift=4194325
;                          Tab=4194306 Escape=4194305
; Tab is `inspect` (select the entity under the cursor). Bullet-time lives on its own action
; because sharing one key between the inspector and the time scale made the inspector
; unreachable — DebugOverlay.select_row had no caller at all.
move_left={
"deadzone": 0.2,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":65,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
]
}
move_right={
"deadzone": 0.2,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":68,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
]
}
